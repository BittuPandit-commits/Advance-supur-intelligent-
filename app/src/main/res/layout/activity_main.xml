<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bittu_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Advance Super Intelligent"
        android:textColor="@color/bittu_accent"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Created by Bittu Pandit"
        android:textColor="@color/bittu_text_secondary"
        android:textSize="12sp" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/chatOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bittu_ai_bubble"
            android:padding="16dp"
            android:text="नमस्ते! मैं Advance Super Intelligent हूँ।\n\nअपना कार्य लिखें—जैसे Login page बनाओ, Calculator app बनाओ, या Todo list app बनाओ।"
            android:textColor="@color/bittu_text"
            android:textSize="16sp" />
    </ScrollView>

    <EditText
        android:id="@+id/taskInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/bittu_surface"
        android:hint="अपना कार्य लिखें"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:padding="14dp"
        android:textColor="@color/bittu_text"
        android:textColorHint="@color/bittu_text_secondary" />

    <Button
        android:id="@+id/sendButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/bittu_accent"
        android:text="भेजें"
        android:textColor="#FFFFFF" />

</LinearLayout>
