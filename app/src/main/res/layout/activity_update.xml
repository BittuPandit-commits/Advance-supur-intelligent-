<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bittu_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bittu AI Update"
        android:textColor="@color/bittu_green"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="नया update GitHub Release से मिलेगा। आपका app data और settings सुरक्षित रहेंगे।"
        android:textColor="@color/bittu_text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/updateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update जाँचा जा रहा है..."
            android:textColor="@color/bittu_text" />
    </ScrollView>

    <Button
        android:id="@+id/updateAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/bittu_green"
        android:text="फिर से जाँचें"
        android:textColor="#FFFFFF" />

</LinearLayout>
